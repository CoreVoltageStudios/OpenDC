<Project>
 <PropertyGroup><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic></PropertyGroup>
 <!-- Godot exports propagate ExportRelease to plain Microsoft.NET.Sdk project
      references too. That custom configuration otherwise defaults to Optimize=false. -->
 <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'"><Optimize>true</Optimize></PropertyGroup>
</Project>
