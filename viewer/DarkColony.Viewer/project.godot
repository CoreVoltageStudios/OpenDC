config_version=5
[application]
config/name="OpenDC"
config/icon="res://Branding/Icon/png/odc-icon-512.png"
config/windows_native_icon="res://Branding/Icon/odc-icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="OpenDarkColony"
boot_splash/bg_color=Color(0.019607844,0.023529412,0.03529412,1)
boot_splash/show_image=false
run/main_scene="res://Main.tscn"
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1600
window/size/window_height_override=900
[dotnet]
project/assembly_name="DarkColony.Viewer"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0,0,0,1)
